        "description": "create table \"question\"",
        "sql": "CREATE TABLE \"public\".\"question\" (\n  \"answer_count\" int4 NOT NULL,\n  \"body\" text NOT NULL,\n  \"content_license\" text,\n  \"custom_score\" float8 NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"question_id\" int8 NOT NULL,\n  \"score\" int4 NOT NULL,\n  \"tags\" text[] NOT NULL,\n  \"title\" text NOT NULL,\n  \"url\" text,\n  \"view_count\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"question_tags_elem_not_null_aecbe9e2\" CHECK (array_position(\"tags\", NULL) IS NULL)\n)",
        "params": []
